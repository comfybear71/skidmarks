# Copy to MY MOVIES\.env and/or blueprint/planner/.env — never commit real values.
# Restart `npm run dev` after changes.

# Voice (Speak / Gen mp3)
ELEVENLABS_API_KEY=

# Character Lab / plate gen (Grok Imagine)
XAI_API_KEY=

# Comfy Cloud — the real animate backend. Set this; leave COMFY_URL blank.
COMFY_CLOUD_API_KEY=

# Self-hosted Comfy only — leave blank when using Comfy Cloud above.
COMFY_URL=

# Neon — Vercel uses these when present. Local Studio still reads Desktop folders.
# Leave blank here. Never put real values in git.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
PGHOST=
PGDATABASE=
PGUSER=
PGPASSWORD=
PGPORT=

# Vercel Blob — Vercel uses these when present. Do not auto-upload from local.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=

# Who can sign in. Leave blank = no login (this PC / cloud VM).
# First email owns every existing pack (Stuie). Everyone else gets their own
# Skidmarks + Sunny Banks — they cannot see, edit, or delete his.
# Local-part of the email is the id: stuie@… and mum@… keep desk jobs mapped.
# STUDIO_USERS=stuie@example.com:password,mum@example.com:otherpassword
STUDIO_USERS=
# Optional. Cookie HMAC. Defaults to STUDIO_USERS if blank.
STUDIO_SESSION_SECRET=
