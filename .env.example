# Copy to MY MOVIES\.env and/or blueprint/planner/.env — never commit real values.
# Restart `npm run dev` after changes.

# Voice (Speak / Gen mp3)
ELEVENLABS_API_KEY=

# Character Lab / plate gen (Grok Imagine)
XAI_API_KEY=

# Siray — Scratch pad Spicy stills + optional Seedance i2v. Create at https://console.siray.ai/keys
# Draw uses Seedream 4.5 ref2i Spicy (~$0.04/image). Scratch Generate can pick Seedance 2.0 i2v Spicy
# (motion only — LTX still owns the Saved mp3). Scratch Draw does not silently fall back to XAI.
SIRAY_API_KEY=

# Comfy Cloud — the real animate backend. Set this; leave COMFY_URL blank.
COMFY_CLOUD_API_KEY=

# Self-hosted Comfy only — leave blank when using Comfy Cloud above.
COMFY_URL=

# Neon — Vercel uses these when present. Local Studio still reads Desktop folders.
# Leave blank here. Never put real values in git.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
PGHOST=
PGDATABASE=
PGUSER=
PGPASSWORD=
PGPORT=

# Vercel Blob — Vercel uses these when present. Do not auto-upload from local.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=

# Who can use M / Scratch / Crash Lab. Homepage stays public either way.
# Leave blank = no login (this PC / cloud VM).
# On Vercel Production set two emails, comma-separated:
# STUDIO_USERS=you@example.com:password,mum@example.com:otherpassword
STUDIO_USERS=
# Optional. Cookie HMAC. Defaults to STUDIO_USERS if blank. Set a random string on Vercel.
STUDIO_SESSION_SECRET=
